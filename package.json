{
  "name": "spina-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 Pi 原生 TUI 的尖晶石制备文献匹配 agent harness",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.mjs",
    "batch": "node --env-file-if-exists=.env src/batch.mjs",
    "setup:pdf": "node --env-file-if-exists=.env src/setup-pdf.mjs",
    "report": "node --disable-warning=ExperimentalWarning src/report.mjs",
    "check": "node src/check.mjs && tsc --noEmit && tsc -p tsconfig.batch.json",
    "test": "node --test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "typescript": "5.9.3"
  }
}

# DeepSeek official API key; fill it locally, never paste into chat.
DEEPSEEK_API_KEY=
SPINA_DISTILL_MODEL=deepseek-flash
SPINA_DISTILL_EFFORT=high
# Repair reasoning effort: low/high/max, independent of distillation effort.
SPINA_REPAIR_EFFORT=max
# Optional PDF overrides; npm run setup:pdf stores local defaults in .runtime/pdf-tools.json.
# SPINA_PDF_PYTHON=C:/path/to/python.exe
# SPINA_OCR_LANGUAGES=eng+chi_sim
# SPINA_OCR_LANG_PATH=.runtime/tessdata
